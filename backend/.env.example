# Gemini API
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
# Browser-safe anon/publishable key. The frontend may use the same public value;
# the backend combines it with each user's JWT so PostgREST enforces RLS.
SUPABASE_ANON_KEY=
# Backend-only service-role/secret key. Never expose this value to the frontend.
# SUPABASE_KEY remains accepted as a temporary Phase 1/2 compatibility alias.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated frontend origins allowed by backend CORS
FRONTEND_ORIGINS=http://localhost:3000
# Optional full-match regex for immutable deployment/preview origins.
# The default is scoped to this repository's Vercel project/team URLs.
FRONTEND_ORIGIN_REGEX=^https://verdict-[a-z0-9-]+-response-composer\.vercel\.app$

# Fallback LLM Providers (Phase 2 - Optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENALEX_MAILTO=
